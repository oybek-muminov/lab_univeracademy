    "/admin/groups/{group_id}/members": {
      "put": {
        "operationId": "groupMembership",
        "summary": "groupMembership",
        "description": "O-01. Teacher with current own-group grant and manage_roster may initially add a never-placed registered pupil, remove own active member, or re-add an inactive pupil whose server-owned placement affinity is this group. A transfer changes affinity even if the pupil is later removed; owning both groups never permits cross-group re-add. Different-affinity active writes by any actor must use privileged transfer. Removal revokes old unstarted grants by membership epoch, cancels unsent notices and recalculates barriers; history and normal-demo usage remain. Re-add never resurrects old grants. Removal retains its separately reviewed active/ready guard. Transfer follows the latest user decision: only a started active attempt blocks; unstarted ready recovery is revoked on successful transfer. Auth/scope/privacy before state and replay; group+membership CAS, transaction and K as x-membership-rules. Returns immutable command receipt. The product authority is confirmed in Master Context 1.0; exact capability/scope, affinity and concurrency mechanics here are review design and do not constitute new historical approvals.",
        "security": [
          {
            "StaffJWT": []
          }
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "description": "Person+method+canonical path+operation; canonical payload. Reauthorize every replay; revoked rights never bypassed. Stable receipt identity, dynamic flags current."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMembershipMutation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "422": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "429": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
