          "503": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberWrite"
              }
            }
          }
        },
        "x-membership-authority": {
          "teacher": {
            "allowed_statuses": [
              "active",
              "removed"
            ],
            "requires_current_own_group_grant": true,
            "requires_manage_roster": true,
            "initial": "no previous membership",
            "readd": "inactive and affinity_group_id equals target",
            "removal": "own current active member",
            "other_affinity_denial": "404 NOT_FOUND; unauthorized candidate existence is hidden"
          },
          "transfer": {
            "executing_roles": [
              "owner",
              "admin"
            ],
            "admin_requires_current_capability_and_source_target_scope": true,
            "direct_member_write_cannot_transfer": true
          },
          "concurrency": {
            "group_revision_precondition": true,
            "membership_revision_precondition": true,
            "person_membership_anchor_lock": true,
            "competing_placement": "one commits; second rechecks privacy: now-foreign affinity404 NOT_FOUND; still-visible stale membership409 STATE_REVISION_CONFLICT, or active409 ACTIVE_GROUP_EXISTS if submitted with current revision",
            "increments": [
              "Group.revision",
              "person.membership_revision"
            ]
          }
        }
      }
    },
    "/admin/assignments": {
      "post": {
        "operationId": "createAssignment",
        "summary": "createAssignment",
        "description": "Explicit group roster, pinned stable demo/version, required IANA timezone and review policy. Admission times do not cap active deadlines. UNIQUE(group,demo) pilot, student global demo usage still enforced. Review timezone confirmed Asia/Tashkent; never assume UTC calendar. Assigned subject/group Teacher may configure reminder_lead_seconds per group test, within approved safe server bounds; never a global fixed lead override. Current content/group grants required. Null disables pre-opening reminder, opening category remains separately consent-controlled. U-GR-15: for already-rostered late pupils, classroom session ending early cannot shorten the protected end-of-day start right. Correct actual assignment UTC close from explicitly configured local day/timezone; Asia/Tashkent is confirmed, actual local exam day still configured explicitly. Latest user decision: Admin initially performs membership and assignment duties; later Teacher delegation must not remove Admin authority. User-confirmed policy A: a current enabled approved Admin may create assignments with existing manage_content and current target-group/version-subject mutation scope. manage_roster is not required for assignment and remains separately required for roster mutations. A test-management-only Admin may assign an already-rostered pupil; a roster-only/read-only Admin cannot create assignments. The endpoint does not create or reactivate membership. Owner existing authority remains; Teacher assignment implementation remains pending. Reauthorize current authority and scope on receipt replay.",
        "security": [
          {
            "StaffJWT": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
