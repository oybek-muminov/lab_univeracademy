  "paths": {
    "/admin/students/{student_id}/transfer": {
      "post": {
        "operationId": "transferStudent",
        "summary": "transferStudent",
        "description": "O-01. Only Owner or delegated Admin with manage_roster and current source/target group scope. Atomic transfer from current group or retained affinity when inactive. Same target as affinity is not a transfer (409 MEMBERSHIP_STATE_CONFLICT); use member route to re-add. Check current membership CAS after auth/privacy; only a started current in_progress attempt with locked now < deadline blocks transfer. At/after deadline materialize completion first. Unstarted approved ready recovery, including a future opens_at, never blocks transfer and is revoked atomically on successful transfer, retaining its historical window and existing attempts/answers. Commit changes affinity+membership epoch, revokes ALL old unstarted grants, keeps result/attempt history and global normal-demo usage; re-add cannot restore old access. Fresh grants require explicit authorization bound to new epoch. See x-membership-rules. No previous affinity is initial placement, not transfer:409 MEMBERSHIP_STATE_CONFLICT; use member route. The latest user decision confirms the transfer active-only guard and cancellation of unstarted recovery eligibility; exact delegation/storage/concurrency mechanics remain local review design. Removal policy is separate.",
        "security": [
          {
            "StaffJWT": []
          }
        ],
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "description": "Person+method+canonical path+operation; canonical payload. Reauthorize every replay; revoked rights never bypassed. Stable receipt identity, dynamic flags current."
