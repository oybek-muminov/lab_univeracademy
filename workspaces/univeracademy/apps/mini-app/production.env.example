# PUBLIC build settings; copy only after Backend/host review. No credentials here.
# Origins have HTTPS scheme and host only; no /api/v1, query, fragment or userinfo.
VITE_MINI_APP_ORIGIN=
VITE_API_ORIGIN=
VITE_STUDENT_CONTRACT_SHA256=f6226aa1cea63ae1fbc603b80aed9232bc4dd5213c4cc081cc13300ee0179b28
# common selects Clerk's provided SignIn form; blank keeps legacy Telegram.
# Custom credential UI remains test/reserve only; no automatic production fallback.
VITE_AUTH_ENTRY=
# Empty socket: do not enable the SDK/form before the real Clerk handoff.
VITE_CLERK_SDK_ENABLED=
# Public values only. No real instance/domain is configured by this candidate.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_FRONTEND_ORIGIN=
# Official SDK head script is opt-in. No real bot/hosting is configured here.
VITE_TELEGRAM_SDK_ENABLED=false
