--- first-student-trusted-server.activation.creator-admin.review.sql
+++ activation.owner-window.review.sql
@@ -14,6 +14,38 @@
 SET LOCAL search_path = pg_catalog, ua_private;
 SET LOCAL lock_timeout = '5s';
 SET LOCAL statement_timeout = '60s';
+-- BEGIN TEMPORARY PRIMARY OWNER WINDOW
+-- Existing empty baseline has only bootstrap-issued creator ADMIN authority.
+-- Reject usable/pre-existing authority; never adopt and later revoke another grant.
+DO $owner_window_before$ BEGIN
+  IF NOT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r
+      WHERE r.rolname='postgres' AND r.oid=current_user::regrole
+        AND current_user=session_user AND NOT r.rolsuper AND r.rolcreaterole AND r.rolbypassrls)
+    OR current_setting('createrole_self_grant') IS DISTINCT FROM ''
+    OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r
+      WHERE r.oid=10 AND r.rolname='supabase_admin' AND r.rolsuper)
+    OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname='ua_owner'
+      AND NOT r.rolsuper AND NOT r.rolbypassrls AND NOT r.rolcanlogin AND NOT r.rolinherit
+      AND NOT r.rolcreaterole AND NOT r.rolcreatedb AND NOT r.rolreplication)
+    OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_namespace WHERE nspname='ua_private' AND nspowner='ua_owner'::regrole)
+    OR pg_catalog.pg_has_role(current_user,'ua_owner','SET')
+    OR pg_catalog.pg_has_role(current_user,'ua_owner','USAGE')
+    OR (SELECT count(*) FROM pg_catalog.pg_auth_members m WHERE m.roleid='ua_owner'::regrole OR m.member='ua_owner'::regrole)<>1
+    OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m
+      WHERE m.roleid='ua_owner'::regrole AND m.member=current_user::regrole AND m.grantor=10
+        AND m.admin_option AND NOT m.inherit_option AND NOT m.set_option) THEN
+    RAISE EXCEPTION 'PRIMARY_OWNER_WINDOW_NOT_READY' USING ERRCODE='42501';
+  END IF;
+END $owner_window_before$;
+GRANT ua_owner TO CURRENT_USER WITH ADMIN FALSE, INHERIT TRUE, SET TRUE GRANTED BY CURRENT_USER;
+DO $owner_window_ready$ BEGIN
+  IF NOT EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m
+    WHERE m.roleid='ua_owner'::regrole AND m.member=current_user::regrole
+      AND m.grantor=current_user::regrole AND NOT m.admin_option AND m.inherit_option AND m.set_option) THEN
+    RAISE EXCEPTION 'TEMPORARY_OWNER_AUTHORITY_MISSING' USING ERRCODE='42501';
+  END IF;
+END $owner_window_ready$;
+-- END TEMPORARY PRIMARY OWNER WINDOW
 -- P2-CTX-01: require the managed-operator authority explicitly; do not use a
 -- superuser success as evidence. A true cluster superuser bypasses ALTER OWNER's
 -- SET-role/schema-CREATE checks and would mask this prerequisite.
@@ -333,4 +365,24 @@
 -- triggers stay enabled. Unlisted tables/commands keep default deny.
 -- This artifact is inactive even if its guard were removed. Do not substitute it
 -- for an independently reviewed, approved executable packet.
+-- BEGIN TEMPORARY PRIMARY OWNER CLOSURE
+SET LOCAL ROLE NONE;
+REVOKE ua_owner FROM CURRENT_USER GRANTED BY CURRENT_USER RESTRICT;
+DO $owner_window_closed$ BEGIN
+  IF current_user IS DISTINCT FROM session_user
+    OR pg_catalog.pg_has_role(current_user,'ua_owner','SET')
+    OR pg_catalog.pg_has_role(current_user,'ua_owner','USAGE')
+    OR EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m
+      WHERE m.roleid='ua_owner'::regrole AND m.member=current_user::regrole AND m.grantor=current_user::regrole)
+    OR (SELECT count(*) FROM pg_catalog.pg_auth_members m WHERE m.roleid='ua_owner'::regrole OR m.member='ua_owner'::regrole)<>1
+    OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m
+      WHERE m.roleid='ua_owner'::regrole AND m.member=current_user::regrole AND m.grantor=10
+        AND m.admin_option AND NOT m.inherit_option AND NOT m.set_option)
+    OR pg_catalog.pg_has_role(current_user,'ua_runtime','SET')
+    OR pg_catalog.pg_has_role(current_user,'ua_runtime','USAGE')
+    OR pg_catalog.pg_has_role('ua_runtime','ua_owner','MEMBER') THEN
+    RAISE EXCEPTION 'TEMPORARY_OWNER_AUTHORITY_SURVIVED' USING ERRCODE='42501';
+  END IF;
+END $owner_window_closed$;
+-- END TEMPORARY PRIMARY OWNER CLOSURE
 ROLLBACK;
